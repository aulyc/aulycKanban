{
	"name": "aulyckanban",
	"version": "2.9.2",
	"description": "Manage tasks with custom types, shared quadrants, archives, search, and Markdown note synchronization.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"build:production": "node esbuild.config.mjs production && node scripts/build-dist.mjs",
		"build": "npm run typecheck && npm run build:production",
		"test": "tsx --test tests/*.test.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --ext .ts,.mjs --max-warnings=0",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm test",
		"ci": "npm run version:check && npm run check && npm run test:coverage && npm run build:production && npm run artifact:verify",
		"version:sync": "node version-bump.mjs sync",
		"version:check": "node version-bump.mjs check",
		"version:set": "node version-bump.mjs set",
		"version:test": "node --test tests/versionBump.test.mjs tests/releaseCheck.test.mjs tests/releaseFlow.test.mjs tests/artifact.test.mjs",
		"artifact:verify": "node scripts/artifact.mjs verify-dist",
		"release:check": "node scripts/release-check.mjs",
		"release:tag": "node scripts/release-tag.mjs",
		"release:test": "node scripts/release.mjs test",
		"release:formal": "node scripts/release.mjs formal",
		"release:test:install": "node scripts/release.mjs test-install",
		"release:formal:install": "node scripts/release.mjs formal-install",
		"formal-git:preflight": "node scripts/formal-git.mjs preflight",
		"install:test": "node scripts/install-plugin.mjs --channel test",
		"install:formal": "node scripts/install-plugin.mjs --channel formal",
		"smoke:obsidian": "node scripts/obsidian-smoke.mjs",
		"test:coverage": "node scripts/coverage.mjs",
		"test:coverage:all": "node scripts/coverage.mjs",
		"test:coverage:critical": "node scripts/coverage.mjs"
	},
	"keywords": [
		"obsidian",
		"kanban",
		"task-management",
		"eisenhower-matrix"
	],
	"author": "AULYC",
	"license": "MIT",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "20.19.11",
		"builtin-modules": "^3.3.0",
		"c8": "12.0.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.7.0",
		"istanbul-lib-coverage": "3.2.2",
		"istanbul-lib-report": "3.0.1",
		"istanbul-reports": "3.2.0",
		"obsidian": "1.12.0",
		"prettier": "^3.6.2",
		"tslib": "^2.4.0",
		"tsx": "4.19.3",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.64.0"
	}
}
